# Copy to .env.local for local development. NEVER put the Supabase secret/service key here.
# Leave these empty to keep telemetry off locally (events are then only printed to the console).
VITE_SUPABASE_URL=
VITE_SUPABASE_KEY=
# Set to 1 to send telemetry from `npm run dev` (rows are tagged env='dev').
VITE_TELEMETRY_IN_DEV=0
